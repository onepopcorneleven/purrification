# Database (R-DATA-1) — see docs/vps-runbook.md step 8 for how the prod
# value is generated and stored on the server.
DATABASE_URL=postgresql://purrification:password@localhost:5432/purrification

# Session signing secret (docs/architecture.md's stateless signed cookie) —
# generate with `openssl rand -base64 32`.
SESSION_SECRET=

# Temporary tester/reviewer convenience: when "true", visitors with no
# session cookie are auto-logged-in as a pinned test user instead of being
# sent to /login (src/lib/auth/guard.ts). Local/test use only — never set
# this in .env.production on the VPS.
DISABLE_AUTH=
